{
    "name": "k-kinzal/doctest-php",
    "description": "PHPUnit extension for testing examples in PHP docblocks",
    "type": "library",
    "license": "MIT",
    "keywords": ["phpunit", "doctest", "testing", "documentation", "examples"],
    "require": {
        "php": "^8.1",
        "phpunit/phpunit": "^10.0 || ^11.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.10"
    },
    "autoload": {
        "psr-4": {
            "Doctest\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Doctest\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpstan analyse",
        "format": "php-cs-fixer fix",
        "format:check": "php-cs-fixer fix --dry-run --diff"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
